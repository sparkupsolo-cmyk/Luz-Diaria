# ==============================================================================
# LUZ DIÁRIA - VARIÁVEIS DE AMBIENTE (EXEMPLO)
# ==============================================================================

# 1. API DO GEMINI (ESTRITAMENTE SERVIDOR)
# Chave da API Google Gemini para geração bíblica teocêntrica dos devocionais.
# NUNCA prefixe com VITE_ e NUNCA envie para o cliente/navegador.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# 2. URL DO PROJETO SUPABASE (PÚBLICO)
# Encontrado no painel do Supabase em Project Settings > API.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_URL="https://your-project-id.supabase.co"

# 3. CHAVE PÚBLICA / ANON KEY (PÚBLICA - NAVEGADOR)
# Chave com privilégios limitados, segura para o navegador.
# Protegida pelo Row Level Security (RLS) do Supabase.
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-or-publishable-key"
SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-or-publishable-key"

# 4. CHAVE PRIVILEGIADA / SERVICE ROLE KEY (ESTRITAMENTE SERVIDOR)
# Encontrada no painel do Supabase em Project Settings > API > service_role (secret).
# UTILIZADA EXCLUSIVAMENTE PELO BACKEND / CRON NO VERCEL.
# Ela permite que o servidor publique na tabela `daily_devotionals` e gerencie
# `generation_locks` contornando o RLS com segurança, enquanto clientes anônimos
# e autenticados possuem apenas permissão de LEITURA.
# NUNCA USE O PREFIXO VITE_ NESTA VARIÁVEL!
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# 5. SEGREDO DO CRON (ESTRITAMENTE SERVIDOR)
# Token secreto para validar requisições disparadas pelo Vercel Cron.
CRON_SECRET="your-secure-random-cron-secret-token"

# 6. URL DA APLICAÇÃO (DEV / PROD)
APP_URL="http://localhost:3000"
